{
  "name": "ai-math-learning-product",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "build": "pnpm -r build",
    "db:migrate": "pnpm --filter @math/db migrate",
    "dev:deps": "docker compose -f infra/compose.yaml up -d postgres",
    "seed:mock": "pnpm --filter @math/api seed -- ../../seed/mock-content-grade-7-semester-1.json",
    "test:foundation": "pnpm --filter @math/api exec vitest run foundation.e2e.test.ts",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "test:native-release": "pnpm --filter @math/db exec tsx test/run-native-release-gates.ts",
    "test:ci-config": "node --test scripts/ci/release-gate.contract.test.mjs && node --test scripts/ci/release-gate.acceptance.test.mjs",
    "verify": "pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "yaml": "2.8.1"
  }
}
