{
  "name": "@math/db",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-migrations.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "migrate": "node --env-file-if-exists=../../.env --import tsx src/migrate.ts",
    "test:native-migration": "node dist/test/native-migration-smoke.js",
    "test": "pnpm run build && vitest run --exclude dist/**"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.2",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "drizzle-kit": "^0.31.10",
    "embedded-postgres": "16.14.0-beta.17",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
